@page
@model App.Features.Run.IndexModel
@{
    ViewData["Title"] = "Donem FIFO";
}

<section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="relative overflow-hidden rounded-[32px] border border-[color:var(--line)] bg-white/80 p-8 shadow-[0_24px_60px_rgba(27,23,18,0.12)] backdrop-blur">
        <div class="absolute inset-0 bg-gradient-to-br from-[color:var(--accent-3)]/20 via-transparent to-transparent"></div>
        <div class="relative">
            <div class="text-xs uppercase tracking-[0.4em] text-[color:var(--accent)]">Donem FIFO</div>
            <h1 class="mt-3 text-3xl font-semibold leading-tight md:text-4xl">2026 alis ve satis maliyetlendirme</h1>
            <p class="mt-4 text-sm leading-6 text-[color:var(--muted)]">
                Donem ici alislar bkm.fifo_StokMaliyetHavuzu tablosuna eklenir, satislar FIFO
                katmanlariyla eslestirilir. Tek urun icin calistirma desteklenir.
            </p>
            <div class="mt-6 flex flex-wrap gap-2 text-xs text-[color:var(--muted)]">
                <span class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1">bkm.sp_fifo_StokMaliyetCalistir</span>
                <span class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1">bkm.fifo_StokMaliyetHavuzu</span>
                <span class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1">bkm.fifo_StokMaliyetCikis</span>
            </div>
        </div>
    </div>

    <div class="rounded-[32px] border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_20px_50px_rgba(27,23,18,0.1)] backdrop-blur">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">Adim kontrolu</div>
        <div class="mt-2 text-lg font-semibold">Donem akisi</div>
        <div class="mt-5 space-y-4 text-sm text-[color:var(--muted)]">
            <div class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 rounded-full bg-[color:var(--accent)]"></span>
                <div>
                    <div class="font-semibold text-[color:var(--ink)]">Alis katmani</div>
                    <div>Donem alislari bkm.fifo_StokMaliyetHavuzu tablosuna yazilir.</div>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 rounded-full bg-[color:var(--accent-2)]"></span>
                <div>
                    <div class="font-semibold text-[color:var(--ink)]">FIFO cikis</div>
                    <div>Satislar FIFO katmanlariyla eslesir ve cikis tablosu dolar.</div>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 rounded-full bg-[color:var(--accent-3)]"></span>
                <div>
                    <div class="font-semibold text-[color:var(--ink)]">Sorun kaydi</div>
                    <div>Eksik maliyetler bkm.fifo_StokMaliyetSorunlu listesine gider.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rounded-3xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_20px_50px_rgba(27,23,18,0.08)] backdrop-blur">
    <form method="post" class="grid gap-6" data-run-form="donem">
        <div class="grid gap-4 lg:grid-cols-2">
            <label class="text-sm text-[color:var(--muted)]">
                <span>Alis baslangic</span>
                <input type="date" asp-for="AlisBaslangic" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-3 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
            <label class="text-sm text-[color:var(--muted)]">
                <span>Alis bitis</span>
                <input type="date" asp-for="AlisBitis" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-3 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
            <label class="text-sm text-[color:var(--muted)]">
                <span>Satis baslangic</span>
                <input type="date" asp-for="SatisBaslangic" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-3 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
            <label class="text-sm text-[color:var(--muted)]">
                <span>Satis bitis</span>
                <input type="date" asp-for="SatisBitis" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-3 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
        </div>

        <div class="grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
            <label class="text-sm text-[color:var(--muted)]">
                <span>Urun ID (opsiyonel)</span>
                <input type="number" asp-for="StkId" placeholder="392" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-3 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
            <div class="rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg)]/60 p-4">
                <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">Adimlar</div>
                <div class="mt-3 space-y-3 text-sm">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" asp-for="CalistirAlis" data-step-toggle="alis" class="h-4 w-4 rounded border-[color:var(--line)] text-[color:var(--accent)] focus:ring-[color:var(--accent)]/30" />
                        <span>Alis katman</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" asp-for="CalistirCikis" data-step-toggle="cikis" class="h-4 w-4 rounded border-[color:var(--line)] text-[color:var(--accent)] focus:ring-[color:var(--accent)]/30" />
                        <span>FIFO cikis</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button class="inline-flex items-center justify-center rounded-full bg-[color:var(--accent)] px-5 py-2 text-sm font-semibold text-white shadow-[0_12px_24px_rgba(31,111,92,0.28)] transition hover:-translate-y-0.5" type="submit" data-run-submit>
                Donem calistir
            </button>
            <span class="text-xs text-[color:var(--muted)]">Gece job icin acilisi calistirmayin.</span>
        </div>

        <div class="rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg)]/70 p-4">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">Zaman cizelgesi</div>
                    <div class="text-sm font-semibold">Donem FIFO akisi</div>
                </div>
                <span class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1 text-[11px] text-[color:var(--muted)]" data-run-status>Hazir</span>
            </div>
            <ol class="run-timeline relative mt-4 space-y-4 border-l border-[color:var(--line)] pl-6" data-run-timeline>
                <li class="relative rounded-2xl border border-[color:var(--line)] bg-white/90 p-4" data-step data-step-key="alis" data-status="idle">
                    <span class="absolute -left-[11px] top-5 h-3 w-3 rounded-full border border-[color:var(--line)] bg-white" data-dot></span>
                    <div class="flex items-center justify-between gap-3">
                        <div class="text-sm font-semibold">Alis katmani</div>
                        <span class="rounded-full border border-[color:var(--line)] px-2 py-0.5 text-[10px] text-[color:var(--muted)]" data-step-state>Bekliyor</span>
                    </div>
                    <div class="mt-2 text-xs text-[color:var(--muted)]">Donem alislari havuza eklenir.</div>
                </li>
                <li class="relative rounded-2xl border border-[color:var(--line)] bg-white/90 p-4" data-step data-step-key="cikis" data-status="idle">
                    <span class="absolute -left-[11px] top-5 h-3 w-3 rounded-full border border-[color:var(--line)] bg-white" data-dot></span>
                    <div class="flex items-center justify-between gap-3">
                        <div class="text-sm font-semibold">FIFO cikis</div>
                        <span class="rounded-full border border-[color:var(--line)] px-2 py-0.5 text-[10px] text-[color:var(--muted)]" data-step-state>Bekliyor</span>
                    </div>
                    <div class="mt-2 text-xs text-[color:var(--muted)]">Satislar FIFO katmanlariyla eslesir.</div>
                </li>
                <li class="relative rounded-2xl border border-[color:var(--line)] bg-white/90 p-4" data-step data-step-key="rapor" data-status="idle">
                    <span class="absolute -left-[11px] top-5 h-3 w-3 rounded-full border border-[color:var(--line)] bg-white" data-dot></span>
                    <div class="flex items-center justify-between gap-3">
                        <div class="text-sm font-semibold">Sonuc hazirligi</div>
                        <span class="rounded-full border border-[color:var(--line)] px-2 py-0.5 text-[10px] text-[color:var(--muted)]" data-step-state>Bekliyor</span>
                    </div>
                    <div class="mt-2 text-xs text-[color:var(--muted)]">Katman kalanlari guncellenir, ozet cikartilir.</div>
                </li>
            </ol>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.DonemError))
        {
            <div class="rounded-2xl border border-[color:var(--accent-2)]/40 bg-[color:var(--accent-2)]/10 px-4 py-3 text-sm text-[color:var(--accent-2)]">
                @Model.DonemError
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DonemStatus))
        {
            <div class="rounded-2xl border border-[color:var(--accent)]/40 bg-[color:var(--accent)]/10 px-4 py-3 text-sm text-[color:var(--accent)]">
                @Model.DonemStatus
            </div>
        }
    </form>
</section>


@section Scripts
{
    <script>
        (() => {
            const form = document.querySelector("[data-run-form='donem']");
            if (!form) return;
            const statusPill = form.querySelector("[data-run-status]");
            const submitButton = form.querySelector("[data-run-submit]");
            const steps = Array.from(form.querySelectorAll("[data-step]"));
            const timeline = form.querySelector("[data-run-timeline]");
            const alisToggle = form.querySelector("[data-step-toggle='alis']");
            const cikisToggle = form.querySelector("[data-step-toggle='cikis']");
            if (!statusPill || !submitButton || !timeline || steps.length === 0) return;

            const labels = {
                idle: "Bekliyor",
                active: "Calisiyor",
                done: "Tamam",
                skipped: "Atlandi",
                error: "Hata"
            };

            const runLabels = {
                READY: "Hazir",
                QUEUED: "Kuyrukta",
                RUNNING: "Calisiyor",
                DONE: "Tamamlandi",
                ERROR: "Hata"
            };

            const setStatus = (item, status) => {
                item.dataset.status = status;
                const badge = item.querySelector("[data-step-state]");
                if (badge) badge.textContent = labels[status] || labels.idle;
            };

            const getEnabledKeys = () => {
                const enabled = new Set();
                if (!alisToggle && !cikisToggle) return enabled;
                if (alisToggle && alisToggle.checked) enabled.add("alis");
                if (cikisToggle && cikisToggle.checked) {
                    enabled.add("cikis");
                    enabled.add("rapor");
                }
                return enabled;
            };

            const lock = () => {
                submitButton.classList.add("opacity-70", "cursor-wait");
                submitButton.disabled = true;
            };

            const unlock = () => {
                submitButton.classList.remove("opacity-70", "cursor-wait");
                submitButton.disabled = false;
                form.dataset.inflight = "false";
            };

            const setRunStatus = (status, message) => {
                const label = runLabels[status] || runLabels.READY;
                statusPill.textContent = message ? `${label} - ${message}` : label;
            };

            const mapStepStatus = (status) => {
                switch (status) {
                    case "RUNNING":
                        return "active";
                    case "DONE":
                        return "done";
                    case "SKIPPED":
                        return "skipped";
                    case "ERROR":
                        return "error";
                    default:
                        return "idle";
                }
            };

            const applySteps = (serverSteps) => {
                const byKey = new Map(serverSteps.map((step) => [step.stepKey, step]));
                steps.forEach((step) => {
                    const key = step.dataset.stepKey;
                    if (!key) return;
                    const match = byKey.get(key);
                    if (!match) return;
                    setStatus(step, mapStepStatus(match.status));
                });
            };

            const buildUrl = (handler, runId) => {
                const url = new URL(form.action, window.location.origin);
                url.searchParams.set("handler", handler);
                if (runId) url.searchParams.set("runId", runId);
                return url.toString();
            };

            let pollTimer = null;
            let activeRunId = null;

            const stopPolling = () => {
                if (pollTimer) {
                    window.clearTimeout(pollTimer);
                    pollTimer = null;
                }
            };

            const poll = async () => {
                if (!activeRunId) return;
                try {
                    const response = await fetch(buildUrl("Log", activeRunId), {
                        headers: { "Accept": "application/json" }
                    });
                    if (!response.ok) throw new Error("Log okunamadi");
                    const data = await response.json();
                    if (!data.ok) throw new Error(data.error || "Log okunamadi");

                    setRunStatus(data.status, data.message);
                    if (Array.isArray(data.steps)) applySteps(data.steps);

                    if (data.status === "DONE" || data.status === "ERROR") {
                        stopPolling();
                        activeRunId = null;
                        unlock();
                        return;
                    }
                    pollTimer = window.setTimeout(poll, 1000);
                } catch (err) {
                    stopPolling();
                    activeRunId = null;
                    setRunStatus("ERROR", "Log hatasi");
                    unlock();
                }
            };

            const reset = () => {
                const enabled = getEnabledKeys();
                steps.forEach((step) => {
                    const key = step.dataset.stepKey;
                    if (enabled.size > 0 && key && !enabled.has(key)) {
                        setStatus(step, "skipped");
                    } else {
                        setStatus(step, "idle");
                    }
                });
                setRunStatus("READY");
            };

            reset();
            unlock();

            if (alisToggle) {
                alisToggle.addEventListener("change", () => {
                    if (form.dataset.inflight === "true") return;
                    reset();
                });
            }
            if (cikisToggle) {
                cikisToggle.addEventListener("change", () => {
                    if (form.dataset.inflight === "true") return;
                    reset();
                });
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                if (form.dataset.inflight === "true") return;

                form.dataset.inflight = "true";
                lock();
                reset();
                setRunStatus("QUEUED");

                try {
                    const response = await fetch(buildUrl("Start"), {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    const data = await response.json();
                    if (!response.ok || !data.ok) {
                        const message = data && data.error ? data.error : "Baslatma hatasi";
                        throw new Error(message);
                    }

                    activeRunId = data.runId;
                    stopPolling();
                    pollTimer = window.setTimeout(poll, 500);
                } catch (err) {
                    setRunStatus("ERROR", err.message);
                    unlock();
                }
            });
        })();
    </script>
}


@if (Model.ShowResults)
{
    <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-[color:var(--line)] bg-white/90 p-4">
            <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">Cikis satiri</div>
            <div class="mt-2 text-2xl font-semibold">@Model.Summary.LineCount</div>
        </div>
        <div class="rounded-2xl border border-[color:var(--line)] bg-white/90 p-4">
            <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">Urun sayisi</div>
            <div class="mt-2 text-2xl font-semibold">@Model.Summary.ProductCount</div>
        </div>
        <div class="rounded-2xl border border-[color:var(--line)] bg-white/90 p-4">
            <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">Toplam maliyet</div>
            <div class="mt-2 text-2xl font-semibold">@Model.Summary.TotalCost.ToString("N2")</div>
        </div>
    </section>

    <section class="rounded-3xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_16px_40px_rgba(27,23,18,0.08)] backdrop-blur">
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">Detay</div>
                <div class="text-lg font-semibold">Ilk 200 FIFO cikis satiri</div>
            </div>
            <div class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1 text-[11px] text-[color:var(--muted)]">bkm.fifo_StokMaliyetCikis</div>
        </div>

        <div class="mt-5 overflow-x-auto rounded-2xl border border-[color:var(--line)] bg-white/95">
            <table class="min-w-full text-sm">
                <thead class="bg-[color:var(--bg)] text-left text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">
                    <tr>
                        <th class="px-4 py-3">Urun</th>
                        <th class="px-4 py-3">Tarih</th>
                        <th class="px-4 py-3">Tip</th>
                        <th class="px-4 py-3">Miktar</th>
                        <th class="px-4 py-3">Birim</th>
                        <th class="px-4 py-3">Tutar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[color:var(--line)]">
                @foreach (var row in Model.Rows)
                {
                    <tr class="hover:bg-[color:var(--bg)]/60">
                        <td class="px-4 py-3 font-semibold">@row.StkId</td>
                        <td class="px-4 py-3">@row.HareketTarihi.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3">@row.HareketTipi</td>
                        <td class="px-4 py-3">@row.Miktar.ToString("N4")</td>
                        <td class="px-4 py-3">@row.BirimMaliyet.ToString("N4")</td>
                        <td class="px-4 py-3">@row.CikisTutar.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
