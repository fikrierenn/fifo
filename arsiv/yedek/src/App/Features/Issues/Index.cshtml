@page
@model App.Features.Issues.IndexModel
@{
    ViewData["Title"] = "Sorunlar";
}

<section class="rounded-3xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_20px_50px_rgba(27,23,18,0.08)] backdrop-blur">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--accent)]">Sorun merkezi</div>
            <h1 class="mt-2 text-2xl font-semibold">Sorunlu stoklar</h1>
            <p class="mt-2 text-sm text-[color:var(--muted)]">Tarih araligina gore sorun kayitlarini filtreleyin.</p>
        </div>
        <form method="get" class="grid gap-4 sm:grid-cols-2">
            <label class="text-sm text-[color:var(--muted)]">
                <span>Baslangic</span>
                <input type="date" asp-for="Baslangic" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-2 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
            <label class="text-sm text-[color:var(--muted)]">
                <span>Bitis</span>
                <input type="date" asp-for="Bitis" class="mt-2 w-full rounded-2xl border border-[color:var(--line)] bg-white/80 px-4 py-2 text-sm text-[color:var(--ink)] shadow-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]/20" />
            </label>
            <div class="sm:col-span-2">
                <button class="inline-flex w-full items-center justify-center rounded-full bg-[color:var(--accent)] px-5 py-2 text-sm font-semibold text-white shadow-[0_12px_24px_rgba(31,111,92,0.28)] transition hover:-translate-y-0.5" type="submit">
                    Filtrele
                </button>
            </div>
        </form>
    </div>
</section>

<section class="grid gap-6">
    <div class="rounded-3xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_16px_40px_rgba(27,23,18,0.08)] backdrop-blur">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">Ozet</div>
        <div class="mt-2 text-lg font-semibold">Sorun tipleri dagilimi</div>
        @if (Model.Summary.Count == 0)
        {
            <div class="mt-4 text-sm text-[color:var(--muted)]">Bu tarih araliginda sorun yok.</div>
        }
        else
        {
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var item in Model.Summary)
                {
                    <div class="rounded-2xl border border-[color:var(--line)] bg-white/90 p-4">
                        <div class="text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">@item.SorunTip</div>
                        <div class="mt-2 text-2xl font-semibold">@item.Adet</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="rounded-3xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_16px_40px_rgba(27,23,18,0.08)] backdrop-blur">
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">Detay</div>
                <div class="text-lg font-semibold">Ilk 200 sorun kaydi</div>
            </div>
            <div class="rounded-full border border-[color:var(--line)] bg-white/80 px-3 py-1 text-[11px] text-[color:var(--muted)]">bkm.fifo_StokMaliyetSorunlu</div>
        </div>

        <div class="mt-5 overflow-x-auto rounded-2xl border border-[color:var(--line)] bg-white/95">
            <table class="min-w-full text-sm">
                <thead class="bg-[color:var(--bg)] text-left text-[11px] uppercase tracking-[0.2em] text-[color:var(--muted)]">
                    <tr>
                        <th class="px-4 py-3">Urun</th>
                        <th class="px-4 py-3">Envanter</th>
                        <th class="px-4 py-3">Tip</th>
                        <th class="px-4 py-3">Miktar</th>
                        <th class="px-4 py-3">Aciklama</th>
                        <th class="px-4 py-3">Kayit</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[color:var(--line)]">
                @foreach (var row in Model.Rows)
                {
                    <tr class="hover:bg-[color:var(--bg)]/60">
                        <td class="px-4 py-3 font-semibold">@row.StkId</td>
                        <td class="px-4 py-3">@row.EnvanterTarihi.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3">@row.SorunTip</td>
                        <td class="px-4 py-3">@row.StokMiktar.ToString("N4")</td>
                        <td class="px-4 py-3 text-[color:var(--muted)]">@row.Aciklama</td>
                        <td class="px-4 py-3">@row.KayitTarihi.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
