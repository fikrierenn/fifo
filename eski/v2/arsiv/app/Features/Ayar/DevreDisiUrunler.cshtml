@page
@model App.Features.Ayar.DevreDisiUrunlerModel
@using App.Lib
@{
    ViewData["Title"] = "Devre Disi Urunler";
}

<!-- Breadcrumb -->
<nav class="mb-4 text-xs text-[color:var(--muted)]">
    <a href="/" class="hover:text-[color:var(--ink)]">Dashboard</a>
    <span class="mx-1">/</span>
    <span class="text-[color:var(--ink)] font-medium">Devre Disi Urunler</span>
</nav>

<div class="mb-8">
    <h1 class="text-2xl font-semibold">Devre Disi Urunler</h1>
    <p class="mt-1 text-sm text-[color:var(--muted)]">FIFO hesaplamasindan haric tutulan urunleri yonetin.</p>
</div>

<!-- Mesaj -->
@if (!string.IsNullOrEmpty(Model.Mesaj))
{
    var mesajCss = Model.MesajHata ? "bg-red-50 border-red-200 text-red-700" : "bg-green-50 border-green-200 text-green-700";
    <div class="rounded-lg border p-3 mb-6 text-sm @mesajCss">@Model.Mesaj</div>
}

<!-- Kategori Bazli Toplu Ekleme — iki bagimsiz panel -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Ana Kategori (KatAna) -->
    <div class="rounded-xl border border-[color:var(--line)] bg-white dark:bg-[color:var(--bg)] p-5">
        <h2 class="text-sm font-semibold mb-2">Kategori Agaci 1 (KatAna)</h2>
        <p class="text-xs text-[color:var(--muted)] mb-3">Edebiyat, Cocuk, Kirtasiye vb.</p>
        <select id="kat-ana" class="w-full rounded-lg border border-[color:var(--line)] px-3 py-2 text-sm mb-3">
            <option value="">-- Kategori Secin --</option>
        </select>
        <div id="kat-ana-info" class="text-xs text-[color:var(--muted)] mb-3"></div>
        <div class="flex gap-2 mb-3">
            <form method="post" asp-page-handler="KategoriEkle" class="inline">
                <input type="hidden" name="kategori" id="kat-ana-form" />
                <input type="hidden" name="sebep" id="kat-ana-sebep" />
                <button type="submit" id="kat-ana-btn-ekle" disabled
                        class="rounded-lg bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700 transition disabled:opacity-40 disabled:cursor-not-allowed">
                    Tumunu Devre Disi Birak
                </button>
            </form>
            <form method="post" asp-page-handler="KategoriKaldir" class="inline">
                <input type="hidden" name="kategori" id="kat-ana-form2" />
                <button type="submit" id="kat-ana-btn-kaldir" disabled
                        class="rounded-lg border border-green-300 px-3 py-1.5 text-xs font-medium text-green-600 hover:bg-green-50 transition disabled:opacity-40 disabled:cursor-not-allowed">
                    Tumunu Aktif Et
                </button>
            </form>
        </div>
        <div id="kat-ana-list" class="rounded-lg border border-[color:var(--line)] hidden">
            <div class="flex items-center gap-3 px-2 py-2 border-b border-[color:var(--line)] bg-gray-50 dark:bg-gray-700">
                <label class="flex items-center gap-1 text-[10px] cursor-pointer"><input type="checkbox" id="kat-ana-selall" class="accent-orange-500"> Tumunu Sec</label>
                <span id="kat-ana-selcount" class="text-[10px] text-[color:var(--muted)]"></span>
                <div class="ml-auto flex gap-1">
                    <button onclick="BKM.dd.topluFromCheckboxes('ana','ekle')" class="px-2 py-0.5 text-[10px] rounded bg-red-600 text-white hover:bg-red-700 transition">Secilenleri Pasif Yap</button>
                    <button onclick="BKM.dd.topluFromCheckboxes('ana','kaldir')" class="px-2 py-0.5 text-[10px] rounded border border-green-300 text-green-600 hover:bg-green-50 transition">Secilenleri Aktif Yap</button>
                </div>
            </div>
            <div class="max-h-64 overflow-y-auto">
                <table class="w-full text-xs">
                    <thead class="sticky top-0 bg-gray-50 dark:bg-gray-700">
                        <tr><th class="px-2 py-1.5 w-6"></th><th class="px-2 py-1.5 text-left">Kod</th><th class="px-2 py-1.5 text-left">Urun</th><th class="px-2 py-1.5 text-center">Durum</th></tr>
                    </thead>
                    <tbody id="kat-ana-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Alt Kategori (Kategori3) -->
    <div class="rounded-xl border border-[color:var(--line)] bg-white dark:bg-[color:var(--bg)] p-5">
        <h2 class="text-sm font-semibold mb-2">Kategori Agaci 2 (Kategori3)</h2>
        <p class="text-xs text-[color:var(--muted)] mb-3">Kitap, Kirtasiye, Oyuncak, Akademi vb.</p>
        <select id="kat-3" class="w-full rounded-lg border border-[color:var(--line)] px-3 py-2 text-sm mb-3">
            <option value="">-- Kategori Secin --</option>
        </select>
        <div id="kat-3-info" class="text-xs text-[color:var(--muted)] mb-3"></div>
        <div class="flex gap-2 mb-3">
            <form method="post" asp-page-handler="Kategori3Ekle" class="inline">
                <input type="hidden" name="kategori3" id="kat-3-form" />
                <input type="hidden" name="sebep" id="kat-3-sebep" />
                <button type="submit" id="kat-3-btn-ekle" disabled
                        class="rounded-lg bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700 transition disabled:opacity-40 disabled:cursor-not-allowed">
                    Tumunu Devre Disi Birak
                </button>
            </form>
            <form method="post" asp-page-handler="Kategori3Kaldir" class="inline">
                <input type="hidden" name="kategori3" id="kat-3-form2" />
                <button type="submit" id="kat-3-btn-kaldir" disabled
                        class="rounded-lg border border-green-300 px-3 py-1.5 text-xs font-medium text-green-600 hover:bg-green-50 transition disabled:opacity-40 disabled:cursor-not-allowed">
                    Tumunu Aktif Et
                </button>
            </form>
        </div>
        <div id="kat-3-list" class="rounded-lg border border-[color:var(--line)] hidden">
            <div class="flex items-center gap-3 px-2 py-2 border-b border-[color:var(--line)] bg-gray-50 dark:bg-gray-700">
                <label class="flex items-center gap-1 text-[10px] cursor-pointer"><input type="checkbox" id="kat-3-selall" class="accent-orange-500"> Tumunu Sec</label>
                <span id="kat-3-selcount" class="text-[10px] text-[color:var(--muted)]"></span>
                <div class="ml-auto flex gap-1">
                    <button onclick="BKM.dd.topluFromCheckboxes('3','ekle')" class="px-2 py-0.5 text-[10px] rounded bg-red-600 text-white hover:bg-red-700 transition">Secilenleri Pasif Yap</button>
                    <button onclick="BKM.dd.topluFromCheckboxes('3','kaldir')" class="px-2 py-0.5 text-[10px] rounded border border-green-300 text-green-600 hover:bg-green-50 transition">Secilenleri Aktif Yap</button>
                </div>
            </div>
            <div class="max-h-64 overflow-y-auto">
                <table class="w-full text-xs">
                    <thead class="sticky top-0 bg-gray-50 dark:bg-gray-700">
                        <tr><th class="px-2 py-1.5 w-6"></th><th class="px-2 py-1.5 text-left">Kod</th><th class="px-2 py-1.5 text-left">Urun</th><th class="px-2 py-1.5 text-center">Durum</th></tr>
                    </thead>
                    <tbody id="kat-3-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Ekleme Formu -->
<div class="rounded-xl border border-[color:var(--line)] bg-white dark:bg-[color:var(--bg)] p-5 mb-8">
    <h2 class="text-sm font-semibold mb-4">Tek Urun Ekle</h2>
    <form method="post" asp-page-handler="Ekle" class="flex flex-wrap items-end gap-4">
        <div class="relative">
            <label class="block text-xs font-medium uppercase tracking-wider text-[color:var(--muted)] mb-1">Urun Ara</label>
            <input type="text" id="dd-search-input" placeholder="Kod veya ad yazin..." autocomplete="off"
                   class="w-64 rounded-lg border border-[color:var(--line)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]" />
            <div id="dd-search-results" class="hidden absolute left-0 right-0 top-full mt-1 z-50 max-h-64 overflow-y-auto rounded-lg border border-[color:var(--line)] bg-white dark:bg-gray-800 shadow-lg"></div>
        </div>
        <div>
            <label class="block text-xs font-medium uppercase tracking-wider text-[color:var(--muted)] mb-1">Stok ID</label>
            <input type="number" name="ekleStkId" id="dd-stkid" required
                   class="w-32 rounded-lg border border-[color:var(--line)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]" />
        </div>
        <div>
            <label class="block text-xs font-medium uppercase tracking-wider text-[color:var(--muted)] mb-1">Sebep</label>
            <input type="text" name="ekleSebep" placeholder="Opsiyonel"
                   class="w-64 rounded-lg border border-[color:var(--line)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[color:var(--accent)]" />
        </div>
        <button type="submit"
                class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 transition-colors">
            Devre Disi Birak
        </button>
    </form>
</div>

<!-- Mevcut Devre Disi Urunler Tablosu -->
<div class="rounded-xl border border-[color:var(--line)] bg-white dark:bg-[color:var(--bg)]">
    <div class="px-5 py-4 border-b border-[color:var(--line)]">
        <h2 class="text-sm font-semibold">Devre Disi Urunler</h2>
        <p class="text-xs text-[color:var(--muted)] mt-0.5">@Model.Urunler.Count urun</p>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-[color:var(--line)] text-left text-xs font-medium uppercase tracking-wider text-[color:var(--muted)]">
                    <th class="px-5 py-3">StkId</th>
                    <th class="px-5 py-3">Urun</th>
                    <th class="px-5 py-3">Sebep</th>
                    <th class="px-5 py-3">Eklenme Tarihi</th>
                    <th class="px-5 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-[color:var(--line)]">
                @if (Model.Urunler.Count == 0)
                {
                    <tr><td colspan="5" class="px-5 py-8 text-center text-[color:var(--muted)]">Devre disi urun bulunmuyor.</td></tr>
                }
                @foreach (var u in Model.Urunler)
                {
                    <tr class="hover:bg-[color:var(--bg)] transition-colors">
                        <td class="px-5 py-3 font-medium tabular-nums">@u.StkId</td>
                        <td class="px-5 py-3">
                            <a href="/Rapor/UrunDetay?stkId=@u.StkId" class="text-[color:var(--accent)] hover:underline">@u.UrunAdi</a>
                        </td>
                        <td class="px-5 py-3 text-[color:var(--muted)] max-w-xs truncate">@(u.Sebep ?? "-")</td>
                        <td class="px-5 py-3 tabular-nums text-[color:var(--muted)]">@u.EklenmeTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="px-5 py-3">
                            <form method="post" asp-page-handler="Kaldir" class="inline">
                                <input type="hidden" name="stkId" value="@u.StkId" />
                                <button type="submit"
                                        onclick="return confirm('Bu urunu yeniden aktif etmek istediginize emin misiniz?')"
                                        class="rounded-md px-3 py-1 text-xs font-medium text-green-600 hover:bg-green-50 transition-colors border border-green-200">
                                    Aktif Et
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
// Urun arama — BKM.urunAra utility
BKM.urunAra({ inputId: 'dd-search-input', resultsId: 'dd-search-results', stkIdInputId: 'dd-stkid' });

// Kategori panelleri — bagimsiz
(async () => {
    let allData = [];
    try {
        const resp = await fetch('/api/kategoriler');
        allData = await resp.json();
    } catch { return; }

    // ── Ana Kategori (KatAna) ──
    const anaSelect = document.getElementById('kat-ana');
    const anaInfo = document.getElementById('kat-ana-info');
    const anaKats = [...new Set(allData.map(r => r.kategori))].sort();
    anaKats.forEach(k => {
        const grp = allData.filter(r => r.kategori === k);
        const toplam = grp.reduce((s, r) => s + r.urunSayisi, 0);
        const dd = grp.reduce((s, r) => s + r.devreDisiSayisi, 0);
        const opt = document.createElement('option');
        opt.value = k;
        opt.textContent = `${k} (${toplam} urun, ${dd} DD)`;
        anaSelect.appendChild(opt);
    });
    anaSelect.addEventListener('change', () => {
        const k = anaSelect.value;
        document.getElementById('kat-ana-form').value = k;
        document.getElementById('kat-ana-form2').value = k;
        document.getElementById('kat-ana-sebep').value = k ? `Kategori: ${k}` : '';
        if (!k) { anaInfo.textContent = ''; setBtns('ana', 0, 0); hideList('ana'); return; }
        const grp = allData.filter(r => r.kategori === k);
        const toplam = grp.reduce((s, r) => s + r.urunSayisi, 0);
        const dd = grp.reduce((s, r) => s + r.devreDisiSayisi, 0);
        anaInfo.innerHTML = `<b>${toplam}</b> urun | <span class="text-red-600 font-medium">${dd}</span> devre disi | <span class="text-green-600 font-medium">${toplam-dd}</span> aktif`;
        setBtns('ana', toplam - dd, dd);
        loadUrunList('ana', 'KatAna', k);
    });

    // ── Alt Kategori (Kategori3) ──
    const kat3Select = document.getElementById('kat-3');
    const kat3Info = document.getElementById('kat-3-info');
    const kat3s = [...new Set(allData.map(r => r.kategori3).filter(Boolean))].sort();
    kat3s.forEach(k => {
        const grp = allData.filter(r => r.kategori3 === k);
        const toplam = grp.reduce((s, r) => s + r.urunSayisi, 0);
        const dd = grp.reduce((s, r) => s + r.devreDisiSayisi, 0);
        const opt = document.createElement('option');
        opt.value = k;
        opt.textContent = `${k} (${toplam} urun, ${dd} DD)`;
        kat3Select.appendChild(opt);
    });
    kat3Select.addEventListener('change', () => {
        const k = kat3Select.value;
        document.getElementById('kat-3-form').value = k;
        document.getElementById('kat-3-form2').value = k;
        document.getElementById('kat-3-sebep').value = k ? `Kategori3: ${k}` : '';
        if (!k) { kat3Info.textContent = ''; setBtns('3', 0, 0); hideList('3'); return; }
        const grp = allData.filter(r => r.kategori3 === k);
        const toplam = grp.reduce((s, r) => s + r.urunSayisi, 0);
        const dd = grp.reduce((s, r) => s + r.devreDisiSayisi, 0);
        kat3Info.innerHTML = `<b>${toplam}</b> urun | <span class="text-red-600 font-medium">${dd}</span> devre disi | <span class="text-green-600 font-medium">${toplam-dd}</span> aktif`;
        setBtns('3', toplam - dd, dd);
        loadUrunList('3', 'Kategori3', k);
    });

    function setBtns(prefix, aktif, dd) {
        document.getElementById(`kat-${prefix}-btn-ekle`).disabled = aktif === 0;
        document.getElementById(`kat-${prefix}-btn-kaldir`).disabled = dd === 0;
    }

    function hideList(prefix) {
        document.getElementById(`kat-${prefix}-list`).classList.add('hidden');
        document.getElementById(`kat-${prefix}-tbody`).innerHTML = '';
    }

    async function loadUrunList(prefix, tip, deger) {
        const listDiv = document.getElementById(`kat-${prefix}-list`);
        const tbody = document.getElementById(`kat-${prefix}-tbody`);
        tbody.innerHTML = '<tr><td colspan="3" class="px-2 py-3 text-center text-[color:var(--muted)]">Yukleniyor...</td></tr>';
        listDiv.classList.remove('hidden');

        try {
            const resp = await fetch(`/api/kategori-urunler?tip=${tip}&deger=${encodeURIComponent(deger)}`);
            const items = await resp.json();
            if (items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="px-2 py-3 text-center text-[color:var(--muted)]">Urun bulunamadi</td></tr>';
                return;
            }
            tbody.innerHTML = items.map(u => {
                const dd = u.devreDisi === 1;
                return `<tr class="${dd ? 'bg-red-50/50 dark:bg-red-900/10' : ''}" data-stkid="${u.stkId}">
                    <td class="px-2 py-1 text-center"><input type="checkbox" class="kat-cb accent-orange-500" value="${u.stkId}"></td>
                    <td class="px-2 py-1 font-mono text-[color:var(--muted)] ${dd ? 'line-through opacity-50' : ''}">${u.kod || u.stkId}</td>
                    <td class="px-2 py-1 ${dd ? 'line-through opacity-50' : ''}">
                        <a href="/Rapor/UrunDetay?stkId=${u.stkId}" class="text-[color:var(--accent)] hover:underline">${BKM.escHtml(u.ad)}</a>
                    </td>
                    <td class="px-2 py-1 text-center">
                        ${dd
                            ? '<span class="inline-block px-1.5 py-0.5 rounded bg-red-100 text-red-700 text-[10px] font-medium dark:bg-red-900/30 dark:text-red-400">Pasif</span>'
                            : '<span class="inline-block px-1.5 py-0.5 rounded bg-green-100 text-green-700 text-[10px] font-medium dark:bg-green-900/30 dark:text-green-400">Aktif</span>'}
                    </td>
                </tr>`;
            }).join('');

            // Checkbox change → sayac guncelle
            tbody.querySelectorAll('.kat-cb').forEach(cb => {
                cb.addEventListener('change', () => updateSelCount(prefix));
            });

            if (items.length >= 200) {
                tbody.innerHTML += '<tr><td colspan="3" class="px-2 py-2 text-center text-[color:var(--muted)] text-[10px]">Ilk 200 urun gosteriliyor...</td></tr>';
            }
        } catch {
            tbody.innerHTML = '<tr><td colspan="3" class="px-2 py-3 text-center text-red-600">Yuklenemedi</td></tr>';
        }
    }

    function updateSelCount(prefix) {
        const cbs = document.querySelectorAll(`#kat-${prefix}-tbody .kat-cb:checked`);
        const span = document.getElementById(`kat-${prefix}-selcount`);
        span.textContent = cbs.length > 0 ? `${cbs.length} secili` : '';
    }

    // Tumunu sec checkbox
    ['ana', '3'].forEach(prefix => {
        const selAll = document.getElementById(`kat-${prefix}-selall`);
        if (selAll) {
            selAll.addEventListener('change', () => {
                document.querySelectorAll(`#kat-${prefix}-tbody .kat-cb`).forEach(cb => {
                    cb.checked = selAll.checked;
                });
                updateSelCount(prefix);
            });
        }
    });
})();

</script>
}
