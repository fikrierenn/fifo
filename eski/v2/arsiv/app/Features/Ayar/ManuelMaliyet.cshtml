@page
@model App.Features.Ayar.ManuelMaliyetModel
@{
    ViewData["Title"] = "Manuel Maliyet";
}

<section class="rounded-2xl border border-gray-200 bg-white p-8 shadow-lg dark:border-gray-700 dark:bg-gray-800">
    <div class="flex items-center justify-between">
        <div>
            <div class="text-xs font-medium uppercase tracking-widest text-violet-600">Ayar</div>
            <h1 class="mt-2 text-2xl font-semibold text-gray-900 dark:text-white">Manuel Maliyet Girisi</h1>
            <p class="mt-2 text-sm text-gray-500">FIFO hesaplamasi disinda, raporlarda override olarak kullanilan birim maliyetler.</p>
        </div>
        <a href="?handler=Export" class="rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300">CSV Export</a>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-lg dark:border-gray-700 dark:bg-gray-800">
    <div class="text-sm font-semibold text-gray-900 dark:text-white">Yeni Kayit Ekle</div>
    <form id="frmEkle" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <label class="block text-sm">
            <span class="font-medium text-gray-600">Urun ID</span>
            <input type="number" name="stkId" required min="1"
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:border-gray-600 dark:bg-gray-700 dark:text-white"
                   placeholder="StkId" />
        </label>
        <label class="block text-sm">
            <span class="font-medium text-gray-600">Birim Maliyet (TL)</span>
            <input type="number" name="birimMaliyet" required min="0.01" step="0.01"
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:border-gray-600 dark:bg-gray-700 dark:text-white"
                   placeholder="0.00" />
        </label>
        <label class="block text-sm">
            <span class="font-medium text-gray-600">Gecerli Baslangic</span>
            <input type="date" name="gecerliBaslangic" required
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
        </label>
        <label class="block text-sm">
            <span class="font-medium text-gray-600">Gecerli Bitis (opsiyonel)</span>
            <input type="date" name="gecerliBitis"
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
        </label>
        <div class="flex items-end">
            <button type="submit"
                    class="w-full rounded-full bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-600/25 hover:bg-violet-700">
                Ekle
            </button>
        </div>
        <label class="block text-sm sm:col-span-2 lg:col-span-5">
            <span class="font-medium text-gray-600">Aciklama (opsiyonel)</span>
            <input type="text" name="aciklama" maxlength="200"
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2.5 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:border-gray-600 dark:bg-gray-700 dark:text-white"
                   placeholder="Neden manuel girildi?" />
        </label>
    </form>
    <div id="mesaj" class="mt-3 hidden rounded-xl border px-4 py-2.5 text-sm"></div>
</section>

<section class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-lg dark:border-gray-700 dark:bg-gray-800">
    <div class="text-lg font-semibold text-gray-900 dark:text-white">Aktif Manuel Maliyetler (@Model.Kayitlar.Count)</div>
    @if (Model.Kayitlar.Count == 0)
    {
        <div class="mt-4 text-sm text-gray-400">Henuz manuel maliyet girisi yok.</div>
    }
    else
    {
    <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-gray-100 text-xs font-medium uppercase tracking-wider text-gray-400 dark:border-gray-700">
                    <th class="pb-3 pr-4">Urun</th>
                    <th class="pb-3 pr-4">Birim Maliyet</th>
                    <th class="pb-3 pr-4">Gecerlilik</th>
                    <th class="pb-3 pr-4">Aciklama</th>
                    <th class="pb-3 pr-4">Tarih</th>
                    <th class="pb-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
                @foreach (var k in Model.Kayitlar)
                {
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-700/30">
                        <td class="py-3 pr-4">
                            <a href="/Rapor/UrunDetay?StkId=@k.StkId" class="font-medium text-violet-600 hover:text-violet-700">
                                @App.Lib.Db.UrunAdi(k.StkId)
                            </a>
                        </td>
                        <td class="py-3 pr-4 font-medium text-gray-900 dark:text-white">@k.BirimMaliyet.ToString("N2") TL</td>
                        <td class="py-3 pr-4 text-xs text-gray-500">
                            @k.GecerliBaslangic.ToString("dd.MM.yyyy")
                            @if (k.GecerliBitis.HasValue) { <span>— @k.GecerliBitis.Value.ToString("dd.MM.yyyy")</span> }
                            else { <span class="text-green-600">→ surekli</span> }
                        </td>
                        <td class="py-3 pr-4 text-xs text-gray-500 max-w-xs truncate">@(k.Aciklama ?? "")</td>
                        <td class="py-3 pr-4 text-xs text-gray-500">@k.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="py-3">
                            <button onclick="silKayit(@k.ManuelId)" class="text-xs text-red-500 hover:text-red-700">Kaldir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</section>

@section Scripts
{
<script>
const mesajEl = document.getElementById("mesaj");

function gosterMesaj(text, hata) {
    mesajEl.classList.remove("hidden", "border-red-200", "bg-red-50", "text-red-600", "border-green-200", "bg-green-50", "text-green-700");
    mesajEl.classList.add(hata ? "border-red-200" : "border-green-200", hata ? "bg-red-50" : "bg-green-50", hata ? "text-red-600" : "text-green-700");
    mesajEl.textContent = text;
}

document.getElementById("frmEkle").addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const url = new URL(window.location.pathname, window.location.origin);
    url.searchParams.set("handler", "Ekle");

    try {
        const resp = await fetch(url, { method: "POST", body: fd });
        const data = await resp.json();
        if (data.ok) { gosterMesaj("Kayit eklendi.", false); setTimeout(() => location.reload(), 800); }
        else gosterMesaj(data.error || "Hata", true);
    } catch (err) { gosterMesaj(err.message, true); }
});

async function silKayit(manuelId) {
    if (!confirm("Bu manuel maliyet kaydini kaldirmak istediginize emin misiniz?")) return;
    const url = new URL(window.location.pathname, window.location.origin);
    url.searchParams.set("handler", "Sil");
    const fd = new FormData();
    fd.append("manuelId", manuelId);

    try {
        const resp = await fetch(url, { method: "POST", body: fd });
        const data = await resp.json();
        if (data.ok) { gosterMesaj("Kayit kaldirildi.", false); setTimeout(() => location.reload(), 800); }
        else gosterMesaj(data.error || "Hata", true);
    } catch (err) { gosterMesaj(err.message, true); }
}
</script>
}
