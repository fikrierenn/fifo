@page
@model App.Features.Yardim.SqlReferansModel
@{
    ViewData["Title"] = "SQL Referans";
}

<section class="rounded-2xl border border-gray-200 bg-white p-8 shadow-lg">
    <div class="text-xs font-medium uppercase tracking-widest text-blue-600">YARDIM</div>
    <h1 class="mt-3 text-3xl font-semibold leading-tight text-gray-900">SQL Referans</h1>
    <p class="mt-3 text-sm leading-6 text-gray-500">
        Her islemin arka planda calistirdigi SQL sorgulari ve stored procedure'ler.
        "Bu buton ne yapiyor?" sorusunun cevabi burada.
    </p>
</section>

<!-- Snapshot SQL'leri -->
<details class="group mt-6 rounded-2xl border border-gray-200 bg-white shadow-lg" open>
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-emerald-100 text-emerald-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Snapshot SQL'leri</div>
                <div class="text-xs text-gray-400">Envanter snapshot olusturma &mdash; Kurulum Sihirbazi Adim 1</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">Snapshot islemi 2 adimdan olusur: eski veriyi temizle, sonra ERP'den cek.</p>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-red-100 px-2 py-0.5 text-[10px] font-bold text-red-700 uppercase">Delete</span>
                <span class="text-xs font-medium text-gray-700">Eski snapshot temizle</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-gray-500">-- Secilen tarih icin mevcut snapshot varsa sil</span>
<span class="text-blue-400">DELETE FROM</span> FifoAcilisEnvanter
<span class="text-blue-400">WHERE</span> EnvanterTarihi = <span class="text-amber-300">@@EnvanterTarihi</span></code></pre>
        </div>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-green-100 px-2 py-0.5 text-[10px] font-bold text-green-700 uppercase">Insert</span>
                <span class="text-xs font-medium text-gray-700">Mekan bazli snapshot cek (her mekan icin ayri calisir)</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">INSERT INTO</span> FifoAcilisEnvanter
    (EnvanterTarihi, MekanId, StkId, StokMiktar)
<span class="text-blue-400">SELECT</span>
    <span class="text-amber-300">@@EnvanterTarihi</span>   <span class="text-blue-400">AS</span> EnvanterTarihi,
    h.ehMekan            <span class="text-blue-400">AS</span> MekanId,
    h.ehstkID            <span class="text-blue-400">AS</span> StkId,
    <span class="text-purple-400">SUM</span>(<span class="text-purple-400">CONVERT</span>(<span class="text-cyan-300">DECIMAL(18,4)</span>, h.ehAdetN)) <span class="text-blue-400">AS</span> StokMiktar
<span class="text-blue-400">FROM</span> DerinSISBkm.dbo.irsHrk h
<span class="text-blue-400">WHERE</span> h.ehMekan = <span class="text-amber-300">@@MekanId</span>
  <span class="text-blue-400">AND</span> h.ehTrhS &lt;= <span class="text-purple-400">CONVERT</span>(<span class="text-cyan-300">smalldatetime</span>, <span class="text-amber-300">@@EnvanterTarihi</span>)
<span class="text-blue-400">GROUP BY</span> h.ehMekan, h.ehstkID
<span class="text-blue-400">HAVING</span> <span class="text-purple-400">SUM</span>(<span class="text-purple-400">CONVERT</span>(<span class="text-cyan-300">DECIMAL(18,4)</span>, h.ehAdetN)) &gt; 0</code></pre>
            <p class="mt-2 text-xs text-gray-500">
                <strong>Mekanlar:</strong> 1 (Merkez), 12 (Sube-12), 4477 (Sube-4477), 4478 (Sube-4478).
                Her mekan icin ayri calisir &mdash; sistemi kilitlememek icin.
            </p>
        </div>
    </div>
</details>

<!-- Acilis Maliyetlendirme -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-blue-100 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Acilis Maliyetlendirme</div>
                <div class="text-xs text-gray-400">Snapshot urunlerine ters fatura aging ile maliyet atama &mdash; Kurulum Sihirbazi Adim 2</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">
            Snapshot'taki distinct StkId'ler alinir ve 200'luk batch'ler halinde SP cagirilir.
        </p>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700 uppercase">Select</span>
                <span class="text-xs font-medium text-gray-700">Snapshot'taki urun listesi</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">SELECT DISTINCT</span> StkId
<span class="text-blue-400">FROM</span> FifoAcilisEnvanter
<span class="text-blue-400">WHERE</span> EnvanterTarihi = <span class="text-amber-300">@@EnvanterTarihi</span></code></pre>
        </div>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-purple-100 px-2 py-0.5 text-[10px] font-bold text-purple-700 uppercase">Exec</span>
                <span class="text-xs font-medium text-gray-700">Her urun icin acilis SP'si (200'luk batch'ler halinde)</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Fifo_AcilisCalistir
    <span class="text-amber-300">@@EnvanterTarihi</span>           = <span class="text-green-300">'2025-12-31'</span>,
    <span class="text-amber-300">@@StkId</span>                    = <span class="text-green-300">12345</span>,
    <span class="text-amber-300">@@IslemId</span>                  = <span class="text-green-300">'guid...'</span>,
    <span class="text-amber-300">@@fallbackSatinalmaSarti</span>   = <span class="text-green-300">'SatinAlma'</span>,
    <span class="text-amber-300">@@atlamaAylikDevir</span>         = <span class="text-green-300">0</span>,
    <span class="text-amber-300">@@sabitFallbackBirimMaliyet</span> = <span class="text-green-300">NULL</span>

<span class="text-gray-500">-- 200'luk batch'ler halinde her urun icin cagirilir</span>
<span class="text-gray-500">-- Her batch arasi iptal kontrolu yapilir</span></code></pre>
        </div>

        <div class="rounded-lg bg-blue-50 border border-blue-200 p-3 text-xs text-blue-800">
            <strong>SP ne yapar:</strong> Urunun snapshot miktarini alir, envanter tarihinden geriye dogru alis faturalarini tarar.
            Her fatura bir FIFO katmani olusturur. Fatura bulunamazsa sentetik (fallback) katman olusturulur.
        </div>
    </div>
</details>

<!-- Aylik FIFO Hesaplama (Batch) -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-violet-100 text-violet-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Aylik FIFO Hesaplama (Batch)</div>
                <div class="text-xs text-gray-400">Batch Baslat sayfasi &mdash; aylik rutin hesaplama</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">4 adimli batch hesaplama sureci:</p>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-violet-600 text-[10px] font-bold text-white">1</span>
                <span class="text-xs font-medium text-gray-700">Hareketli urun listesini al</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Fifo_HareketliUrunListesi <span class="text-amber-300">@@Yil</span>, <span class="text-amber-300">@@Ay</span>

<span class="text-gray-500">-- Donemde hareketi olan (alis veya cikis) urunlerin</span>
<span class="text-gray-500">-- StkId listesini dondurur.</span></code></pre>
        </div>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-violet-600 text-[10px] font-bold text-white">2</span>
                <span class="text-xs font-medium text-gray-700">Batch run kaydi olustur</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Fifo_BatchRunBaslat
    <span class="text-amber-300">@@RunId</span>       = <span class="text-green-300">'guid...'</span>,
    <span class="text-amber-300">@@DonemYil</span>    = <span class="text-green-300">2026</span>,
    <span class="text-amber-300">@@DonemAy</span>     = <span class="text-green-300">1</span>,
    <span class="text-amber-300">@@ToplamUrun</span>  = <span class="text-green-300">3500</span>,
    <span class="text-amber-300">@@ToplamBatch</span> = <span class="text-green-300">7</span>,
    <span class="text-amber-300">@@BatchBoyutu</span> = <span class="text-green-300">500</span></code></pre>
        </div>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-violet-600 text-[10px] font-bold text-white">3</span>
                <span class="text-xs font-medium text-gray-700">Her batch icin TVP ile toplu hesaplama</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-gray-500">-- TVP (Table-Valued Parameter) ile 500 StkId tek seferde gonderilir</span>
<span class="text-blue-400">EXEC</span> sp_Fifo_AylikCalistirBatch
    <span class="text-amber-300">@@Yil</span>       = <span class="text-green-300">2026</span>,
    <span class="text-amber-300">@@Ay</span>        = <span class="text-green-300">1</span>,
    <span class="text-amber-300">@@StkIdList</span> = <span class="text-green-300">&lt;TVP: StkIdListType&gt;</span>,  <span class="text-gray-500">-- DataTable ile gonderilir</span>
    <span class="text-amber-300">@@RunId</span>     = <span class="text-green-300">'guid...'</span>,
    <span class="text-amber-300">@@BatchNo</span>   = <span class="text-green-300">1</span>

<span class="text-gray-500">-- SP iceride her StkId icin:</span>
<span class="text-gray-500">--   1. Onceki aydan devir katman olustur</span>
<span class="text-gray-500">--   2. Yeni alis katmanlari ekle (faturalardan)</span>
<span class="text-gray-500">--   3. Cikislari FIFO sirasiyla hesapla</span>
<span class="text-gray-500">--   4. Sentetik katman olustur (gerekirse)</span></code></pre>
        </div>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-violet-600 text-[10px] font-bold text-white">4</span>
                <span class="text-xs font-medium text-gray-700">Batch run kaydini kapat</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Fifo_BatchRunBitir
    <span class="text-amber-300">@@RunId</span>      = <span class="text-green-300">'guid...'</span>,
    <span class="text-amber-300">@@Durum</span>      = <span class="text-green-300">'TAMAMLANDI'</span>,
    <span class="text-amber-300">@@HataMesaji</span> = <span class="text-green-300">NULL</span></code></pre>
        </div>
    </div>
</details>

<!-- FIFO Hesapla (Tek Urun / Full Rutin) -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-indigo-100 text-indigo-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 002.25 2.25h10.5a2.25 2.25 0 002.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0012 2.25z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">FIFO Hesapla (Tek Urun / Full Rutin)</div>
                <div class="text-xs text-gray-400">FIFO Hesapla sayfasi ve Kurulum Sihirbazi Adim 3</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">
            Tek urun veya tum urunler icin aylik FIFO hesaplama. Wizard Adim 3 ve FIFO Hesapla sayfasi ayni SP'yi kullanir.
        </p>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-purple-100 px-2 py-0.5 text-[10px] font-bold text-purple-700 uppercase">Exec</span>
                <span class="text-xs font-medium text-gray-700">Aylik rutin (devir + alis + cikis + sentetik)</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Fifo_AylikRutinFull
    <span class="text-amber-300">@@Yil</span>                       = <span class="text-green-300">2026</span>,
    <span class="text-amber-300">@@Ay</span>                        = <span class="text-green-300">1</span>,
    <span class="text-amber-300">@@StkId</span>                     = <span class="text-green-300">NULL</span>,        <span class="text-gray-500">-- NULL = tum urunler, veya tek StkId</span>
    <span class="text-amber-300">@@IslemId</span>                   = <span class="text-green-300">'guid...'</span>,
    <span class="text-amber-300">@@SentetikSatinalmaSarti</span>    = <span class="text-green-300">'SatinAlma'</span>,
    <span class="text-amber-300">@@SabitFallbackBirimMaliyet</span> = <span class="text-green-300">NULL</span>,
    <span class="text-amber-300">@@SentetikAktif</span>             = <span class="text-green-300">1</span>

<span class="text-gray-500">-- SP iceride su adimlari sirayla yapar:</span>
<span class="text-gray-500">-- 1. Onceki aydan devir katmanlari olustur (DEVIR tip)</span>
<span class="text-gray-500">-- 2. ERP faturalarindan alis katmanlari ekle (ALIS tip)</span>
<span class="text-gray-500">-- 3. ERP cikislarini FIFO sirasiyla hesapla</span>
<span class="text-gray-500">-- 4. Eksik katmanlara sentetik katman olustur (SENTETIK tip)</span></code></pre>
        </div>

        <div class="rounded-lg bg-indigo-50 border border-indigo-200 p-3 text-xs text-indigo-800">
            <strong>Not:</strong> <code class="font-mono">commandTimeout: 1800</code> (30 dakika) &mdash; tum urunler icin uzun surebilir.
            Tek urun icin genellikle saniyeler icerisinde tamamlanir.
        </div>
    </div>
</details>

<!-- Ortalama Maliyet -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-green-100 text-green-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Ortalama Maliyet</div>
                <div class="text-xs text-gray-400">Ay Sonu sayfasi &mdash; agirlikli ortalama hesaplama</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">
            FIFO hesaplamadan bagimsiz, tum alislarin agirlikli ortalamasini hesaplar ve
            <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono">OrtalamaAylikMaliyet</code> tablosuna yazar.
        </p>

        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-purple-100 px-2 py-0.5 text-[10px] font-bold text-purple-700 uppercase">Exec</span>
                <span class="text-xs font-medium text-gray-700">Aylik ortalama maliyet hesapla</span>
            </div>
            <pre class="rounded-xl bg-gray-900 p-4 text-xs text-gray-100 font-mono leading-relaxed overflow-x-auto"><code><span class="text-blue-400">EXEC</span> sp_Ortalama_AylikHesapla <span class="text-amber-300">@@Yil</span>, <span class="text-amber-300">@@Ay</span>

<span class="text-gray-500">-- SP iceride:</span>
<span class="text-gray-500">-- 1. Donemde alislari toplar (toplam tutar / toplam miktar)</span>
<span class="text-gray-500">-- 2. OrtalamaAylikMaliyet tablosuna yazar (YilAy, StkId, BirimMaliyet)</span>
<span class="text-gray-500">-- 3. Idempotent: ayni donem icin tekrar calistiginda gunceller</span></code></pre>
        </div>

        <div class="rounded-lg bg-green-50 border border-green-200 p-3 text-xs text-green-800">
            <strong>Ipucu:</strong> Batch Baslat sayfasinda "Ortalama Hesapla" secenegi isaretliyse,
            batch tamamlandiktan sonra bu SP otomatik olarak cagirilir. Ayri bir adim olarak da Ay Sonu sayfasindan calistirilabilir.
        </div>
    </div>
</details>

