      "dogrulandi": "2026-09-10 -> 77 (tam pipeline sonrasi degismedi; GARANTI tier yeni otomatik devre-disi eklemedi)"
    },
    {
      "id": "cikis-miktar-pozitif",
      "db": "BKMMaliyet",
      "soru": "FifoCikisDetay.Miktar <= 0 olan satir var mi?",
      "neden": "CHECK constraint zorluyor. Sifir/negatif cikis miktari, CikisTutar hesabini (Miktar * BirimMaliyet) anlamsiz yapar.",
