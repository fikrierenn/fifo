<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fifo.Hangfire</RootNamespace>
    <AssemblyName>Fifo.Hangfire</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fifo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB -->
    <PackageReference Include="Microsoft.Data.SqlClient"   Version="5.*" />
    <PackageReference Include="Dapper"                     Version="2.*" />

    <!-- Transitif guvenlik acigi override: Hangfire -> Newtonsoft.Json 11.0.1 -->
    <PackageReference Include="Newtonsoft.Json"               Version="13.*" />

    <!-- Background jobs -->
    <PackageReference Include="Hangfire.Core"              Version="1.*" />
    <PackageReference Include="Hangfire.AspNetCore"        Version="1.*" />
    <PackageReference Include="Hangfire.SqlServer"         Version="1.*" />

    <!-- Resilience -->
    <PackageReference Include="Polly"                      Version="8.*" />
    <PackageReference Include="Polly.Extensions"           Version="8.*" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore"         Version="8.*" />
    <PackageReference Include="Serilog.Sinks.Console"      Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File"         Version="6.*" />
    <PackageReference Include="Serilog.Enrichers.Thread"   Version="4.*" />
  </ItemGroup>

</Project>
