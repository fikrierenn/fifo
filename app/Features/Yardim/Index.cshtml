@page
@model App.Features.Yardim.IndexModel
@{
    ViewData["Title"] = "Kullanim Kilavuzu";
}

<section class="rounded-2xl border border-gray-200 bg-white p-8 shadow-lg">
    <div class="text-xs font-medium uppercase tracking-widest text-blue-600">YARDIM</div>
    <h1 class="mt-3 text-3xl font-semibold leading-tight text-gray-900">BKM Maliyet &mdash; Kullanim Kilavuzu</h1>
    <p class="mt-3 text-sm leading-6 text-gray-500">
        FIFO ve Ortalama maliyet hesaplama sistemi rehberi. Tum islemleri adim adim ogrenmek icin asagidaki bolumleri inceleyin.
    </p>
</section>

<!-- Bolum 1: Sistem Nedir? -->
<details class="group mt-6 rounded-2xl border border-gray-200 bg-white shadow-lg" open>
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-blue-100 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Sistem Nedir?</div>
                <div class="text-xs text-gray-400">BKM Maliyet, FIFO, Ortalama Maliyet kavramlari</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-6">
        <!-- BKM Maliyet Nedir -->
        <div>
            <h3 class="text-sm font-semibold text-gray-800 mb-2">BKM Maliyet Nedir?</h3>
            <div class="space-y-2 text-sm leading-relaxed text-gray-600">
                <p>
                    BKM Maliyet, isletmenizin stok maliyetlerini dogru ve guncel hesaplamak icin gelistirilmis bir sistemdir.
                    DerinSIS ERP sistemindeki stok hareketlerini (alis, satis, sarf, iade vb.) otomatik olarak ceker ve bu verileri
                    kullanarak her urunun birim maliyetini hesaplar.
                </p>
                <p>
                    Sistem iki farkli maliyet hesaplama yontemini destekler: <strong>FIFO (First In, First Out)</strong> ve
                    <strong>Agirlikli Ortalama Maliyet</strong>. Her iki yontemi de esanli olarak calistirip sonuclarini
                    karsilastirmaniza olanak tanir. Bu sayede isletmeniz icin en uygun maliyet yaklasimini belirleyebilirsiniz.
                </p>
                <p>
                    Sistem 4 farkli mekan (sube) icin ayri ayri calisir:
                </p>
                <div class="flex flex-wrap gap-2 mt-1">
                    <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">Merkez (1)</span>
                    <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700">Sube-12</span>
                    <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-medium text-purple-700">Sube-4477</span>
                    <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-medium text-orange-700">Sube-4478</span>
                </div>
            </div>
        </div>

        <!-- FIFO Nedir -->
        <div class="rounded-xl bg-blue-50/60 p-5">
            <h3 class="text-sm font-semibold text-blue-800 mb-2">FIFO Nedir?</h3>
            <div class="space-y-2 text-sm leading-relaxed text-blue-900/80">
                <p>
                    FIFO, <strong>"First In, First Out" (Ilk Giren, Ilk Cikar)</strong> anlamina gelir. Bir urun satildiginda veya
                    sarf edildiginde, <em>en eski alistan baslayarak</em> maliyet hesaplanir. Yani ilk ne fiyattan aldiysaniz, satista
                    o fiyat once kullanilir.
                </p>
                <p class="font-medium text-blue-800">Ornek:</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs">
                        <thead>
                            <tr class="border-b border-blue-200">
                                <th class="py-2 pr-4 text-left font-medium">Islem</th>
                                <th class="py-2 pr-4 text-right font-medium">Adet</th>
                                <th class="py-2 pr-4 text-right font-medium">Birim Fiyat</th>
                                <th class="py-2 text-right font-medium">Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-blue-100">
                                <td class="py-1.5 pr-4">1. Alis (Katman 1)</td>
                                <td class="py-1.5 pr-4 text-right">100</td>
                                <td class="py-1.5 pr-4 text-right">10,00 TL</td>
                                <td class="py-1.5 text-right">1.000 TL</td>
                            </tr>
                            <tr class="border-b border-blue-100">
                                <td class="py-1.5 pr-4">2. Alis (Katman 2)</td>
                                <td class="py-1.5 pr-4 text-right">50</td>
                                <td class="py-1.5 pr-4 text-right">15,00 TL</td>
                                <td class="py-1.5 text-right">750 TL</td>
                            </tr>
                            <tr class="bg-blue-100/50">
                                <td class="py-1.5 pr-4 font-medium">Satis (120 adet)</td>
                                <td class="py-1.5 pr-4 text-right">120</td>
                                <td class="py-1.5 pr-4 text-right">&mdash;</td>
                                <td class="py-1.5 text-right font-bold">1.300 TL</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-xs text-blue-700 mt-2">
                    120 adet satildiginda: ilk 100 adet Katman 1'den (10 TL x 100 = 1.000 TL), kalan 20 adet Katman 2'den
                    (15 TL x 20 = 300 TL) dusulur. Toplam maliyet: <strong>1.300 TL</strong>.
                </p>
                <div class="mt-3 space-y-1 text-xs">
                    <p><strong>Katman</strong> = Her alis islemi bir katman olusturur. Katmanda miktar ve birim fiyat bilgisi bulunur.</p>
                    <p><strong>Cikis</strong> = Satis veya sarf islemi. En eski katmandan baslayarak miktar dusulur.</p>
                </div>
            </div>
        </div>

        <!-- Ortalama Maliyet Nedir -->
        <div class="rounded-xl bg-green-50/60 p-5">
            <h3 class="text-sm font-semibold text-green-800 mb-2">Ortalama Maliyet Nedir?</h3>
            <div class="space-y-2 text-sm leading-relaxed text-green-900/80">
                <p>
                    Agirlikli ortalama maliyet yonteminde, tum alislarin <strong>toplam tutari</strong> toplam miktara bolunur.
                    Her alista birim fiyat yeniden hesaplanir.
                </p>
                <p class="font-medium text-green-800">Ornek:</p>
                <div class="bg-white/50 rounded-lg p-3 text-xs font-mono">
                    100 adet x 10 TL = 1.000 TL<br/>
                    &nbsp;50 adet x 15 TL = &nbsp;&nbsp;750 TL<br/>
                    <span class="border-t border-green-300 inline-block w-full my-1"></span>
                    150 adet &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= 1.750 TL<br/>
                    <strong>Birim maliyet = 1.750 / 150 = 11,67 TL</strong>
                </div>
            </div>
        </div>

        <!-- Neden ikisi de lazim -->
        <div class="rounded-xl bg-gray-50 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-2">Neden Ikisi de Lazim?</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="rounded-lg border border-blue-200 bg-white p-4">
                    <div class="font-semibold text-blue-700 mb-1">FIFO</div>
                    <ul class="space-y-1 text-xs text-gray-600">
                        <li>Gercek maliyeti yansitir</li>
                        <li>Vergi avantaji saglar (enflasyonlu ortamda)</li>
                        <li>Muhasebe standartlarina uygun</li>
                        <li>Urun bazinda detayli maliyet takibi</li>
                    </ul>
                </div>
                <div class="rounded-lg border border-green-200 bg-white p-4">
                    <div class="font-semibold text-green-700 mb-1">Ortalama Maliyet</div>
                    <ul class="space-y-1 text-xs text-gray-600">
                        <li>Hesaplamasi basit ve hizli</li>
                        <li>Fiyat dalgalanmalarini yumusatir</li>
                        <li>Hizli karar verme icin ideal</li>
                        <li>Genel maliyet trendi gosterir</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</details>

<!-- Bolum 2: Ilk Kurulum -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-emerald-100 text-emerald-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Ilk Kurulum (Adim Adim)</div>
                <div class="text-xs text-gray-400">Snapshot, Acilis Maliyetlendirme, Ilk Hesaplama</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-6">

        <!-- Adim 1: Envanter Snapshot -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-5">
            <div class="flex items-center gap-2 mb-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-600 text-xs font-bold text-white">1</span>
                <h3 class="text-sm font-semibold text-emerald-800">Envanter Snapshot</h3>
            </div>
            <div class="space-y-2 text-sm leading-relaxed text-gray-600">
                <p>
                    <strong>Nedir:</strong> DerinSIS ERP'deki stok hareketlerini tarayarak, belirli bir tarihteki stok miktarlarini
                    <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono">FifoAcilisEnvanter</code> tablosuna kaydeder.
                    Sistem "bu tarihte elde ne kadar stok vardi?" sorusunu yanitlar.
                </p>
                <p>
                    <strong>Ne zaman:</strong> Ilk kurulumda bir kez yapilir. Genellikle yil sonu (31.12) secilir. Sonraki aylarda
                    tekrar yapilmaz &mdash; devir mekanizmasi otomatik calisir.
                </p>
                <p>
                    <strong>Nasil:</strong>
                </p>
                <ol class="list-decimal list-inside space-y-1 text-xs ml-2">
                    <li>Sol menudan <strong>"Kurulum Sihirbazi"</strong> sayfasina gidin</li>
                    <li>Envanter tarihi secin (ornegin 31.12.2025)</li>
                    <li><strong>"Snapshot Olustur"</strong> butonuna basin</li>
                    <li>Islem arka planda calisir &mdash; ilerlemeyi ekranda takip edin</li>
                </ol>
                <div class="mt-2 rounded-lg bg-amber-50 border border-amber-200 p-3 text-xs text-amber-800">
                    <strong>Dikkat:</strong> ERP'den yaklasik 500.000 kayit cekilir. 4 mekan icin toplam 30-60 saniye surebilir.
                    Her mekan arasi iptal edilebilir. Snapshot zaten varsa tekrar cekilmez (atlenir).
                </div>
                <div class="mt-2 rounded-lg bg-gray-100 p-3 text-xs font-mono text-gray-700 overflow-x-auto">
                    INSERT INTO FifoAcilisEnvanter (...)<br/>
                    SELECT ... FROM DerinSISBkm.dbo.irsHrk<br/>
                    WHERE ehMekan = @@MekanId AND ehTrhS &lt;= @@EnvanterTarihi<br/>
                    GROUP BY ehMekan, ehstkID<br/>
                    HAVING SUM(...) &gt; 0
                </div>
            </div>
        </div>

        <!-- Adim 2: Acilis Maliyetlendirme -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-5">
            <div class="flex items-center gap-2 mb-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-600 text-xs font-bold text-white">2</span>
                <h3 class="text-sm font-semibold text-emerald-800">Acilis Maliyetlendirme</h3>
            </div>
            <div class="space-y-2 text-sm leading-relaxed text-gray-600">
                <p>
                    <strong>Nedir:</strong> Snapshot'taki her urun icin geriye donuk faturalari tarar ve FIFO katmanlari olusturur.
                    "Ters fatura aging" yontemiyle en yeni faturadan baslayarak, eldeki stok miktarini karsilayacak kadar alis
                    faturasi bulur.
                </p>
                <p>
                    <strong>Mantik:</strong> Her urun icin su islem yapilir:
                </p>
                <ol class="list-decimal list-inside space-y-1 text-xs ml-2">
                    <li>Urunun snapshot'taki stok miktari alinir</li>
                    <li>Envanter tarihinden geriye dogru alis faturalari taranir</li>
                    <li>Her fatura bir <strong>katman</strong> olusturur (miktar + birim fiyat)</li>
                    <li>Fatura bulunamazsa <strong>sentetik katman</strong> (fallback fiyat) olusturulur</li>
                </ol>
                <p>
                    <strong>SP:</strong> <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono">sp_Fifo_AcilisCalistir</code>
                    &mdash; urun bazli calisir, 200'luk batch'lerle cagirilir.
                </p>
                <div class="mt-2 rounded-lg bg-amber-50 border border-amber-200 p-3 text-xs text-amber-800">
                    <strong>Dikkat:</strong> Urun sayisina bagli olarak uzun surebilir (binlerce urun = dakikalar).
                    Her batch arasi iptal edilebilir. Kismi hatalar olabilir &mdash; bazi urunlerin faturasi bulunamayabilir.
                </div>
            </div>
        </div>

        <!-- Adim 3: Ilk Ay Hesaplamasi -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-5">
            <div class="flex items-center gap-2 mb-3">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-emerald-600 text-xs font-bold text-white">3</span>
                <h3 class="text-sm font-semibold text-emerald-800">Ilk Ay Hesaplamasi</h3>
            </div>
            <div class="space-y-2 text-sm leading-relaxed text-gray-600">
                <p>
                    <strong>Nedir:</strong> Acilis katmanlari uzerine, ilk ayin alis ve cikis hareketlerini isler.
                    Yeni alislar yeni katman olusturur, satislar mevcut katmanlardan FIFO sirasiyla dusar.
                </p>
                <p>
                    <strong>SP:</strong> <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono">sp_Fifo_AylikRutinFull</code>
                    &mdash; tek SP ile devir + alis katman + FIFO cikis + sentetik katman islemlerinin tumunu yapar.
                </p>
                <p>
                    <strong>Ornek:</strong> Snapshot 31.12.2025 ise, ilk hesaplama Ocak 2026 (Yil: 2026, Ay: 1) icin yapilir.
                </p>
                <div class="mt-2 rounded-lg bg-blue-50 border border-blue-200 p-3 text-xs text-blue-800">
                    <strong>Ipucu:</strong> Ilk hesaplamadan sonra, sonraki aylar icin "Batch Baslat" sayfasini kullanin.
                    Kurulum Sihirbazi sadece ilk kurulum icindir.
                </div>
            </div>
        </div>
    </div>
</details>

<!-- Bolum 3: Aylik Rutin Islemler -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-violet-100 text-violet-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            </span>
            <div>
                <div class="text-lg font-semibold text-gray-900">Aylik Rutin Islemler</div>
                <div class="text-xs text-gray-400">Her ay tekrarlanan islemler ve otomasyon</div>
            </div>
        </div>
        <svg class="h-5 w-5 text-gray-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </summary>
    <div class="border-t border-gray-100 px-6 pb-6 pt-4 space-y-4">
        <p class="text-sm text-gray-600">Her ayin basinda (veya onceki ay kapandiginda) asagidaki adimlari sirayla uygulayin:</p>

        <div class="space-y-3">
            <div class="flex items-start gap-3 rounded-lg border border-gray-100 p-4">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-violet-600 text-xs font-bold text-white">1</span>
                <div>
                    <div class="text-sm font-semibold text-gray-800">Batch Baslat</div>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Sol menudan <strong>"Batch Baslat"</strong> sayfasina gidin. Yil ve ay secip "Baslat" butonuna basin.
                        Sistem hareketli urunleri tespit eder, 500'luk batch'ler halinde FIFO hesaplar.
                        Ilerleme canli olarak goruntulenir.
                    </p>
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-lg border border-gray-100 p-4">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-violet-600 text-xs font-bold text-white">2</span>
                <div>
                    <div class="text-sm font-semibold text-gray-800">Hatali Urunleri Kontrol Et</div>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Batch bittikten sonra <strong>"Hatali Retry"</strong> sayfasini kontrol edin. Bazi urunler fatura
                        eksikligi veya veri tutarsizligi nedeniyle hata verebilir. Bu urunleri tek tek veya toplu olarak
                        tekrar deneyebilirsiniz.
                    </p>
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-lg border border-gray-100 p-4">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-violet-600 text-xs font-bold text-white">3</span>
                <div>
                    <div class="text-sm font-semibold text-gray-800">Ortalama Maliyet Hesapla</div>
                    <p class="text-xs text-gray-500 mt-0.5">
                        <strong>"Ay Sonu"</strong> sayfasindan ortalama maliyet hesaplamasini calistirin. Batch sirasinda
                        "Ortalama Hesapla" secenegi isaretliyse bu adim otomatik yapilmistir.
                    </p>
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-lg border border-gray-100 p-4">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-violet-600 text-xs font-bold text-white">4</span>
                <div>
                    <div class="text-sm font-semibold text-gray-800">Raporlari Kontrol Et</div>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Dashboard, Karsilastirma ve Sorunlu Stoklar raporlarini inceleyin. Anormal degerler varsa
                        detay raporlarindan arastirin.
                    </p>
                </div>
            </div>
        </div>

        <div class="rounded-lg bg-violet-50 border border-violet-200 p-4 mt-4">
            <div class="flex items-center gap-2 text-sm font-semibold text-violet-800 mb-1">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Hangfire Otomasyon
            </div>
            <p class="text-xs text-violet-700">
                Hangfire yapilandirmasi mevcutsa, her ayin 1'i saat 01:00'de aylik FIFO hesaplama otomatik calisir.
                Hangfire Panel'den zamanlama ve gecmis calismalari gorebilirsiniz. Otomatik calisma basarisiz olursa
                manuel olarak "Batch Baslat" ile tekrarlayabilirsiniz.
            </p>
        </div>
    </div>
</details>

<!-- Bolum 4: Raporlar Rehberi -->
<details class="group mt-4 rounded-2xl border border-gray-200 bg-white shadow-lg">
    <summary class="flex cursor-pointer items-center justify-between p-6 text-left select-none">
        <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-amber-100 text-amber-600">
