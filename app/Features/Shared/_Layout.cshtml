        <aside class="hidden lg:flex w-64 flex-col border-r border-[color:var(--line)] bg-white/80 backdrop-blur">
            <div class="flex items-center gap-3 px-6 py-6 border-b border-[color:var(--line)]">
                <div class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--accent)] text-xs font-bold tracking-wider text-white">
                    BKM
                </div>
                <div>
                    <div class="text-sm font-semibold">Maliyet</div>
                    <div class="text-[11px] text-[color:var(--muted)]">FIFO & Ortalama</div>
                </div>
            </div>

            <nav class="flex-1 px-4 py-6 space-y-1">
