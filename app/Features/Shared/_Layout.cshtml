                    <svg data-icon-moon class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
                    <svg data-icon-sun class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
                    <span>Tema degistir</span>
                </button>
                <div class="rounded-lg bg-[color:var(--bg)] px-3 py-2 text-[11px] text-[color:var(--muted)]">
                    <span class="font-medium text-[color:var(--ink)]">BKMMaliyet</span> &middot; SQL Server
                </div>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex-1 flex flex-col">
            <header class="sticky top-0 z-10 border-b border-[color:var(--line)] bg-[color:var(--bg)]/80 backdrop-blur lg:hidden">
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="text-sm font-semibold">BKM Maliyet</div>
                    <nav class="flex items-center gap-3 text-xs text-[color:var(--muted)]">
                        <a asp-page="/Rapor/Index" class="@(currentPage == "/Rapor/Index" ? "font-semibold text-[color:var(--ink)]" : "hover:text-[color:var(--ink)]")">Rapor</a>
                        <a asp-page="/Rapor/Karsilastirma" class="@(currentPage == "/Rapor/Karsilastirma" ? "font-semibold text-[color:var(--ink)]" : "hover:text-[color:var(--ink)]")">Karsil.</a>
                        <a asp-page="/Fifo/Acilis" class="@(currentPage == "/Fifo/Acilis" ? "font-semibold text-[color:var(--ink)]" : "hover:text-[color:var(--ink)]")">Acilis</a>
                        <a asp-page="/Fifo/Hesapla" class="@(currentPage == "/Fifo/Hesapla" ? "font-semibold text-[color:var(--ink)]" : "hover:text-[color:var(--ink)]")">Hesapla</a>
                        <a asp-page="/Ortalama/AySonu" class="@(currentPage == "/Ortalama/AySonu" ? "font-semibold text-[color:var(--ink)]" : "hover:text-[color:var(--ink)]")">Ort.</a>
                    </nav>
                </div>
            </header>

            <main class="flex-1 mx-auto w-full max-w-6xl px-6 py-8">
                @RenderBody()
            </main>

            <footer class="border-t border-[color:var(--line)] py-4 text-center text-xs text-[color:var(--muted)]">
                BKM Maliyet &middot; FIFO & Ortalama
            </footer>
        </div>
    </div>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
