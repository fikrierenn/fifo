@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var linkBase = "flex items-center rounded-xl px-4 py-2.5 text-sm transition";
    var linkActive = $"{linkBase} bg-[color:var(--accent)]/10 text-[color:var(--accent)] font-medium";
    var linkIdle = $"{linkBase} text-[color:var(--muted)] hover:bg-[color:var(--accent)]/5 hover:text-[color:var(--ink)]";
}
<!DOCTYPE html>
<html lang="tr">
<script>if(localStorage.getItem('theme')==='dark')document.documentElement.classList.add('dark');</script>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BKM Maliyet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[color:var(--bg)] font-['Inter'] text-[color:var(--ink)]">

    <div class="flex min-h-screen">
