                    <div class="relative">
                        <input id="sidebar-search-input" type="text" placeholder="Urun kodu veya adi ara..." class="w-full rounded-lg border border-[color:var(--line)] bg-[color:var(--bg)] px-3 py-2 pl-8 text-xs text-[color:var(--ink)] placeholder-[color:var(--muted)] focus:border-[color:var(--accent)] focus:outline-none focus:ring-1 focus:ring-[color:var(--accent)]/30" />
                        <svg class="absolute left-2.5 top-2.5 h-3 w-3 text-[color:var(--muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
