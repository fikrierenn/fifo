@page
@model App.Features.Rapor.HareketliUrunlerModel
@{
    ViewData["Title"] = "Hareketli Urunler";
}

<section class="rounded-2xl border border-gray-200 bg-white p-8 shadow-lg">
    <div class="text-xs font-medium uppercase tracking-widest text-blue-600">Rapor</div>
    <h1 class="mt-3 text-3xl font-semibold leading-tight text-gray-900">Hareketli Urunler</h1>
    <p class="mt-3 text-sm leading-6 text-gray-500">
        Secilen ay icinde hareketi olan urunleri ve aktif FIFO katman ozetlerini listeler.
    </p>
</section>

<section class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-lg">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <label class="block text-sm text-gray-600">
            <span class="font-medium">Yil</span>
            <input type="number" asp-for="Yil" min="2020" max="2099"
                   class="mt-2 block w-28 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        </label>
        <label class="block text-sm text-gray-600">
            <span class="font-medium">Ay</span>
            <input type="number" asp-for="Ay" min="1" max="12"
                   class="mt-2 block w-24 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        </label>
        <button type="submit"
                class="inline-flex items-center justify-center rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5 hover:bg-blue-700 active:translate-y-0">
            Listele
        </button>
        @if (Model.Sorgulandimi && Model.Urunler.Count > 0)
        {
            <a asp-page="/Rapor/HareketliUrunler" asp-page-handler="Csv" asp-route-Yil="@Model.Yil" asp-route-Ay="@Model.Ay"
               class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-5 py-3 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                CSV
            </a>
        }
    </form>
</section>

@if (Model.Sorgulandimi)
{
    <section class="mt-6 rounded-2xl border border-gray-200 bg-white shadow-lg">
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
            <div>
                <div class="text-sm font-semibold text-gray-900">@Model.Yil / @Model.Ay.ToString("D2")</div>
                <div class="text-xs text-gray-400"><span id="shown-count">@Model.Urunler.Count</span> / @Model.ToplamUrunSayisi urun</div>
            </div>
        </div>

        @if (Model.Urunler.Count == 0)
        {
            <div class="px-6 py-12 text-center text-sm text-gray-400">
                Bu donem icin hareketli urun bulunamadi.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left text-xs font-medium uppercase tracking-wider text-gray-400">
                            <th class="px-6 py-3">Urun</th>
                            <th class="px-6 py-3 text-right">Katman Sayisi</th>
                            <th class="px-6 py-3 text-right">Kalan Miktar</th>
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-gray-100">
                        @foreach (var u in Model.Urunler)
                        {
                            <tr class="transition hover:bg-gray-50 @(Db.DevreDisiMi(u.StkId) ? "devre-disi" : "")" data-href="/Rapor/UrunDetay?stkId=@u.StkId" data-stkid="@u.StkId">
                                <td class="px-6 py-3">
                                    <a asp-page="/Rapor/UrunDetay" asp-route-stkId="@u.StkId"
                                       class="font-medium text-blue-600 hover:underline">@Db.UrunAdi(u.StkId)</a>
                                </td>
                                <td class="px-6 py-3 text-right tabular-nums">@u.KatmanSayisi</td>
                                <td class="px-6 py-3 text-right tabular-nums">@u.KalanMiktar.ToString("N4")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="load-spinner" class="hidden py-4 text-center">
                <svg class="inline h-6 w-6 animate-spin text-blue-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                <span class="ml-2 text-sm text-gray-500">Yukleniyor...</span>
            </div>
            <div id="load-done" class="hidden py-3 text-center text-xs text-gray-400">Tum veriler yuklendi.</div>
        }
    </section>
}

@section Scripts {
<script>
@if (Model.Urunler.Count > 0 && Model.HasMore)
{
    @:BKM.infiniteScroll({
    @:    tbodyId: 'table-body',
    @:    spinnerId: 'load-spinner',
    @:    doneId: 'load-done',
    @:    shownCountId: 'shown-count',
    @:    initialOffset: @Model.Urunler.Count,
    @:    hasMore: true,
    @:    filterParams: 'Yil=@Model.Yil&Ay=@Model.Ay',
    @:    rowClass: 'transition hover:bg-gray-50',
    @:    renderRow: r => `<td class="px-6 py-3"><a href="/Rapor/UrunDetay?stkId=${r.stkId}" class="font-medium text-blue-600 hover:underline">${r.urunAdi}</a></td><td class="px-6 py-3 text-right tabular-nums">${r.katmanSayisi}</td><td class="px-6 py-3 text-right tabular-nums">${r.kalanMiktar}</td>`
    @:});
}
</script>
}
