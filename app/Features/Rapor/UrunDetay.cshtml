<!-- Devir ozeti artik tablo icinde (ilk ve son satir) -->

@section Scripts {
<script>
@if (Model.OrtalamaMaliyetler.Count > 1) {
    var labels = string.Join(",", Model.OrtalamaMaliyetler.OrderBy(o => o.YilAy).Select(o => $"'{o.YilAy}'"));
    var data = string.Join(",", Model.OrtalamaMaliyetler.OrderBy(o => o.YilAy).Select(o => o.AySonuBirimMaliyet.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)));
    @Html.Raw($"BKM.line('chartOrtTrend', [{labels}], [{{ label: 'Ort. Birim Maliyet', data: [{data}], borderColor: '#8b5cf6', backgroundColor: '#8b5cf620' }}]);")
}

// Tab navigasyonu
(() => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('[data-panel]');
    tabs.forEach(btn => {
        btn.addEventListener('click', () => {
            const target = btn.dataset.tab;
            tabs.forEach(t => t.classList.remove('active', 'bg-white', 'shadow-sm', 'text-[color:var(--ink)]'));
            btn.classList.add('active', 'bg-white', 'shadow-sm', 'text-[color:var(--ink)]');
            panels.forEach(p => {
                if (p.dataset.panel === target) p.classList.remove('hidden');
                else p.classList.add('hidden');
            });
        });
    });
    // URL'den tab state'i oku veya ilk tab'i ac
    const urlTab = new URLSearchParams(location.search).get('tab');
    const targetBtn = urlTab
        ? document.querySelector(`.tab-btn[data-tab="${urlTab}"]`)
        : document.querySelector('.tab-btn.active');
    if (targetBtn) targetBtn.click();
})();

// Stok Hareketleri filtre: sube aninda, tarih blur'da submit
(() => {
    const form = document.getElementById('hrkFilterForm');
    if (!form) return;
    // Sube select: aninda submit
    form.querySelectorAll('select').forEach(el => {
        el.addEventListener('change', () => form.submit());
    });
    // Tarih inputlari: focus kaybedince submit (yazma bitsin diye)
    form.querySelectorAll('input[type="date"]').forEach(el => {
        const orig = el.value;
        el.addEventListener('blur', () => { if (el.value !== orig) form.submit(); });
    });
})();

async function toggleDevreDisiDetay(stkId) {
    const btn = document.getElementById('dd-toggle-btn');
    const isDD = btn.textContent.trim() === 'Aktif Et';
    const ok = await BKM.dd.toggle(stkId, isDD);
    if (ok) location.reload();
}
</script>
}
